<Window x:Class="MscToolsInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MscTool - Bộ Cài Đặt Add-in Revit (2025 - 2026 - 2027)" 
        Height="640" Width="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F8FAFC">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F1F5F9"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0284C7"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0284C7"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0369A1"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#EF4444"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#EF4444"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#DC2626"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#0F172A"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.Row="0" Background="#0F172A" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="🛠️" FontSize="32" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="MSCTOOLS FOR AUTODESK REVIT" FontWeight="Bold" FontSize="16" Foreground="#38BDF8"/>
                    <TextBlock Text="Bộ Cài Đặt Tích Hợp Đa Phiên Bản: Revit 2025, 2026, 2027" FontSize="12.5" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <!-- DESCRIPTION -->
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="📦 Các công cụ được tích hợp trong bộ cài:" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,6"/>
                        <TextBlock Text="• Trích xuất tọa độ hàng loạt Family (Project Base Point / Survey Point / Origin)" Foreground="#1E3A8A" Margin="0,2"/>
                        <TextBlock Text="• Di chuyển / Sao chép tọa độ đối tượng (Move &amp; Copy tương tác 2 chiều)" Foreground="#1E3A8A" Margin="0,2"/>
                        <TextBlock Text="• Tạo Shape Image sơ đồ minh họa cho thép Custom không có trong BS 8666" Foreground="#1E3A8A" Margin="0,2"/>
                        <TextBlock Text="• Theo dõi và kiểm tra lịch sử thay đổi sau mỗi lần Synchronize with Central" Foreground="#1E3A8A" Margin="0,2"/>
                    </StackPanel>
                </Border>

                <!-- SECTION: CHỌN PHIÊN BẢN REVIT -->
                <TextBlock Text="1. CHỌN CÁC PHIÊN BẢN REVIT CẦN CÀI ĐẶT:" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,8"/>

                <!-- REVIT 2025 CARD -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="ChkRevit2025" Content="Autodesk Revit 2025" IsChecked="False"/>
                            <TextBlock Text=".NET 10 Runtime | Thư mục Addins 2025" FontSize="11.5" Foreground="#64748B" Margin="24,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="Badge2025" Background="#DCFCE7" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus2025" Text="Đang kiểm tra..." FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- REVIT 2026 CARD -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="ChkRevit2026" Content="Autodesk Revit 2026" IsChecked="False"/>
                            <TextBlock Text=".NET 10 Runtime | Thư mục Addins 2026" FontSize="11.5" Foreground="#64748B" Margin="24,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="Badge2026" Background="#F1F5F9" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus2026" Text="Đang kiểm tra..." FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- REVIT 2027 CARD -->
                <Border Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <CheckBox x:Name="ChkRevit2027" Content="Autodesk Revit 2027" IsChecked="False"/>
                            <TextBlock Text=".NET 10 Runtime | Thư mục Addins 2027" FontSize="11.5" Foreground="#64748B" Margin="24,2,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" x:Name="Badge2027" Background="#DCFCE7" Padding="8,4" CornerRadius="4" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtStatus2027" Text="Đang kiểm tra..." FontSize="11" FontWeight="SemiBold" Foreground="#166534"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- SECTION: PHẠM VI CÀI ĐẶT -->
                <TextBlock Text="2. PHẠM VI CÀI ĐẶT:" FontWeight="Bold" FontSize="13" Foreground="#334155" Margin="0,0,0,6"/>
                <StackPanel Margin="0,0,0,14">
                    <RadioButton x:Name="RbCurrentUser" Content="Cài đặt cho người dùng hiện tại (%APPDATA% - Khuyên dùng, không cần Admin)" IsChecked="True" Margin="0,2,0,4"/>
                    <RadioButton x:Name="RbAllUsers" Content="Cài đặt cho tất cả người dùng (%PROGRAMDATA% - Cần quyền Admin)" Margin="0,2,0,4"/>
                </StackPanel>

                <!-- PROGRESS BAR & STATUS LOG -->
                <ProgressBar x:Name="PrgProgress" Height="8" Margin="0,0,0,6" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtLog" Text="Sẵn sàng cài đặt. Vui lòng chọn phiên bản Revit và bấm 'Cài Đặt'." FontSize="12" Foreground="#475569" TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- FOOTER BUTTONS -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnUninstall" Content="🗑️ Gỡ Cài Đặt" Width="120" Click="BtnUninstall_Click" Style="{StaticResource DangerButton}"/>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BtnInstall" Content="🚀 Cài Đặt (Install)" Width="150" Margin="0,0,8,0" Click="BtnInstall_Click" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="BtnClose" Content="Đóng" Width="80" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
