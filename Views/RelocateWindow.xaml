<Window x:Class="ElementCoordinateExtractor.Views.RelocateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Element Relocator - Di Chuyển Đối Tượng Theo Tọa Độ" 
        Height="680" Width="920"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C1C7D0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0052CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0747A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00875A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#006644"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BAR: SELECTION & COORDINATE SYSTEM -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="14" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#DFE1E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Selection summary and pick button -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtSelectionSummary" Grid.Column="0" Text="Đang chọn: 0 đối tượng" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#0747A6"/>
                    <Button Grid.Column="1" Content="🎯 Quét / Chọn lại trong Revit" Click="BtnPickInRevit_Click"/>
                </Grid>

                <!-- Row 2: Coordinate System & Unit -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Hệ tọa độ:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbProjectBasePoint" Content="Project Base Point (Mốc dự án)" IsChecked="True" Checked="CoordinateSystem_Checked"/>
                        <RadioButton x:Name="RbSurveyPoint" Content="Survey Point (Mốc trắc địa / Shared)" Checked="CoordinateSystem_Checked"/>
                        <RadioButton x:Name="RbInternalOrigin" Content="Internal Origin (Gốc Revit)" Checked="CoordinateSystem_Checked"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Đơn vị:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboUnits" Grid.Column="3" Height="28" VerticalContentAlignment="Center" SelectionChanged="CboUnits_SelectionChanged">
                        <ComboBoxItem Content="Millimeters (mm)" IsSelected="True"/>
                        <ComboBoxItem Content="Meters (m)"/>
                        <ComboBoxItem Content="Feet (ft)"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- CENTER DATAGRID (SELECTED ELEMENTS) -->
        <Border Grid.Row="1" Background="#FFFFFF" CornerRadius="6" BorderBrush="#DFE1E6" BorderThickness="1" Margin="0,0,0,10">
            <DataGrid x:Name="DgrElements" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserSortColumns="True"
                      SelectionMode="Single"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EBECF0"
                      HeadersVisibility="Column"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFBFC"
                      BorderThickness="0"
                      SelectionChanged="DgrElements_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="100"/>
                    <DataGridTextColumn Header="Tên Đối Tượng" Binding="{Binding ElementName}" Width="*"/>
                    <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding PinnedStatus}" Width="120"/>
                    <DataGridTextColumn x:Name="ColX" Header="X Hiện Tại" Binding="{Binding FormattedX}" Width="120"/>
                    <DataGridTextColumn x:Name="ColY" Header="Y Hiện Tại" Binding="{Binding FormattedY}" Width="120"/>
                    <DataGridTextColumn x:Name="ColZ" Header="Z Hiện Tại" Binding="{Binding FormattedZ}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- INPUT NEW COORDINATES / DELTA SECTION -->
        <Border Grid.Row="2" Background="#F0F4F8" Padding="14" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#B3D4FF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="📍 Thiết Lập Vị Trí / Tọa Độ Mới" FontWeight="Bold" Foreground="#0747A6" Margin="0,0,0,10"/>

                <!-- Two input modes linked together: Absolute Target vs Relative Delta -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tọa độ mới tuyệt đối -->
                    <Border Grid.Column="0" Background="#FFFFFF" Padding="10" CornerRadius="4" BorderBrush="#DFE1E6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cách 1: Nhập Tọa Độ Tuyệt Đối Mới" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="X Mới:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtNewX" Grid.Column="1" TextChanged="TxtNewTarget_TextChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Y Mới:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtNewY" Grid.Column="1" TextChanged="TxtNewTarget_TextChanged"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Z Mới:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtNewZ" Grid.Column="1" TextChanged="TxtNewTarget_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Divider -->
                    <TextBlock Grid.Column="1" Text="hoặc" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#5E6C84" FontStyle="Italic"/>

                    <!-- Right: Khoảng dời Delta tương đối -->
                    <Border Grid.Column="2" Background="#FFFFFF" Padding="10" CornerRadius="4" BorderBrush="#DFE1E6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Cách 2: Nhập Khoảng Dời (Offset Δ)" FontWeight="SemiBold" Foreground="#172B4D" Margin="0,0,0,8"/>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Δ X:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtDeltaX" Grid.Column="1" TextChanged="TxtDelta_TextChanged"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Δ Y:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtDeltaY" Grid.Column="1" TextChanged="TxtDelta_TextChanged"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Δ Z:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                <TextBox x:Name="TxtDeltaZ" Grid.Column="1" TextChanged="TxtDelta_TextChanged"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Checkbox options -->
                <CheckBox x:Name="ChkUnpin" Grid.Row="2" Content="Tự động bỏ ghim (Unpin) nếu đối tượng đang bị ghim (Pinned)" IsChecked="True" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- BOTTOM ACTIONS -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Sẵn sàng." VerticalAlignment="Center" Foreground="#5E6C84"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="📋 Tạo Bản Sao (Copy)" Style="{StaticResource AccentButton}" Click="BtnCopy_Click"/>
                <Button Content="🚀 Di Chuyển Đến Tọa Độ Mới" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0" Click="BtnMove_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
