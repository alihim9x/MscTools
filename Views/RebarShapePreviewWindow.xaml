<Window x:Class="ElementCoordinateExtractor.Views.RebarShapePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xem Trước &amp; Tinh Chỉnh Rebar Shape Image - MscTools" 
        Height="780" Width="1140"
        MinHeight="680" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C1C7D0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0052CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0747A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00875A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#006644"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RoundMiniButton" TargetType="Button">
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#DFE1E6"/>
            <Setter Property="Background" Value="#FAFBFC"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="13"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP BANNER -->
        <Border Grid.Row="0" Background="#0052CC" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="🖼️ XEM TRƯỚC &amp; TINH CHỈNH REBAR SHAPE IMAGE" 
                               FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Text="Xem trước sơ đồ uốn thanh thép và điều chỉnh hệ số chiều dài kích thước (A, B, C...) trước khi gán vào Rebar Shape." 
                               FontSize="12" Foreground="#DEEBFF" Margin="0,3,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#0747A6" CornerRadius="12" Padding="12,4" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTotalShapesCount" Text="0 Shape" FontWeight="Bold" Foreground="#FFFFFF"/>
                </Border>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA: 2 COLUMNS -->
        <Grid Grid.Row="1" Margin="14,12,14,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: LIST OF SHAPES -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Danh Sách Shape Thép Được Chọn" FontWeight="Bold" FontSize="13" Foreground="#172B4D" Margin="4,2,4,8"/>

                    <ListBox Grid.Row="1" x:Name="LstShapes" BorderThickness="0" Background="Transparent" 
                             SelectionChanged="LstShapes_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,2,0,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6" Padding="10,8">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#DEEBFF"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0052CC"/>
                                                    <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1.5"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4C9AFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Shape Name & Icon -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding ShapeName}" FontWeight="Bold" FontSize="13" Foreground="#172B4D"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusIcon}" FontSize="12" Margin="4,0,0,0"/>
                                    </Grid>

                                    <!-- Legs summary & status text -->
                                    <Grid Grid.Row="1" Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding LegsSummary}" FontSize="11" Foreground="#5E6C84" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" 
                                                   Foreground="{Binding StatusBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Left Column Footer: Batch Assign All -->
                    <Border Grid.Row="2" BorderBrush="#DFE1E6" BorderThickness="0,1,0,0" Padding="0,10,0,0" Margin="0,8,0,0">
                        <Button x:Name="BtnAssignAll" Style="{StaticResource AccentButton}" Content="💾 Gán TẤT CẢ các Shape" Click="BtnAssignAll_Click"/>
                    </Border>
                </Grid>
            </Border>

            <!-- RIGHT COLUMN: PREVIEW & FACTORS CONTROLS -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOP CARD: LIVE PREVIEW OF SHAPE IMAGE -->
                <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Preview Card Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Hình Ảnh Xem Trước (Live Preview)" FontWeight="Bold" FontSize="13" Foreground="#172B4D"/>
                                <TextBlock Text=" • Tỉ lệ 2:1 (800 x 400 px chuẩn bảng thống kê Revit)" FontSize="11" Foreground="#6B778C" Margin="6,2,0,0"/>
                            </StackPanel>

                            <Border Grid.Column="1" Background="#F4F5F7" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="4" Padding="8,2">
                                <TextBlock x:Name="TxtActiveShapeBadge" Text="Shape" FontWeight="SemiBold" FontSize="12" Foreground="#0052CC"/>
                            </Border>
                        </Grid>

                        <!-- Controls Toolbar: Flip, Horizontal Edge, Dim Offset -->
                        <Border Grid.Row="1" Background="#F4F5F7" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="4" Padding="8,4" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Flip & Edge Buttons -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnFlipX" Content="↔ Lật Trái / Phải" ToolTip="Lật ngược hình dạng theo phương ngang (Trái ↔ Phải)" 
                                            Padding="8,4" Margin="0,0,6,0" Click="BtnFlipX_Click"/>
                                    <Button x:Name="BtnFlipY" Content="↕ Lật Lên / Xuống" ToolTip="Lật ngược hình dạng theo phương đứng (Lên ↕ Xuống)" 
                                            Padding="8,4" Margin="0,0,6,0" Click="BtnFlipY_Click"/>
                                    <Button x:Name="BtnCycleHorizontal" Content="🔄 Đổi Cạnh Ngang" ToolTip="Chọn cạnh khác làm cạnh luôn nằm ngang" 
                                            Padding="8,4" Margin="0,0,6,0" Click="BtnCycleHorizontal_Click"/>
                                    <Button x:Name="BtnResetOrientation" Content="↺ Mặc Định" ToolTip="Khôi phục hướng và khoảng cách ban đầu" 
                                            Padding="6,4" Margin="0,0,6,0" Click="BtnResetOrientation_Click"/>
                                </StackPanel>

                                <!-- Right: Dim Offset Control -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="📏 Offset Dim:" VerticalAlignment="Center" FontSize="12" Foreground="#172B4D" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource RoundMiniButton}" Content="-" Click="BtnDecreaseDimOffset_Click" Margin="0,0,4,0"/>
                                    <Slider x:Name="SliderDimOffset" Minimum="15" Maximum="80" Width="90" VerticalAlignment="Center"
                                            SmallChange="2" LargeChange="5"
                                            ValueChanged="SliderDimOffset_ValueChanged" Margin="0,0,4,0"/>
                                    <Button Style="{StaticResource RoundMiniButton}" Content="+" Click="BtnIncreaseDimOffset_Click" Margin="0,0,6,0"/>
                                    <TextBlock x:Name="TxtDimOffsetValue" Text="35 px" Width="40" FontWeight="Bold" Foreground="#0052CC" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Preview Image Container -->
                        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#EBECF0" BorderThickness="1" CornerRadius="4">
                            <Grid>
                                <Image x:Name="ImgPreview" Stretch="Uniform" 
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       RenderOptions.EdgeMode="Aliased"
                                       Margin="8"/>

                                <!-- Placeholder when no image -->
                                <TextBlock x:Name="TxtNoPreviewPlaceholder" 
                                           Text="Vui lòng chọn một Shape ở danh sách bên trái để xem trước sơ đồ uốn." 
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="#8993A4" FontStyle="Italic" Visibility="Collapsed"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- BOTTOM CARD: ADJUST SEGMENT FACTORS -->
                <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Controls Header -->
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="⚙️ Tinh Chỉnh Chiều Dài Các Đoạn Kích Thước" 
                                       FontWeight="Bold" FontSize="13" Foreground="#172B4D" VerticalAlignment="Center"/>

                            <CheckBox Grid.Column="2" x:Name="ChkSyncEqual" Content="🔗 Tự động đồng bộ các đoạn cùng kích thước" 
                                      IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" 
                                      Checked="ChkSyncEqual_Changed" Unchecked="ChkSyncEqual_Changed"/>

                            <Button Grid.Column="3" Content="🔄 Đặt lại tỉ lệ (1.0)" Padding="8,4" Click="BtnResetFactors_Click"/>
                        </Grid>

                        <!-- List of Segments (Legs) -->
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,2,0,4">
                            <ItemsControl x:Name="ItemsLegs">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="195" Background="#FAFBFC" BorderBrush="#DFE1E6" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,10,0">
                                            <StackPanel>
                                                <!-- Leg Header: Circle Badge + Real Length -->
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Circle Badge for Label (A, B, C...) -->
                                                    <Border Grid.Column="0" Background="#0052CC" CornerRadius="12" Width="24" Height="24">
                                                        <TextBlock Text="{Binding Label}" Foreground="#FFFFFF" FontWeight="Bold" 
                                                                   FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>

                                                    <TextBlock Grid.Column="1" Text="{Binding LengthMmFormatted}" 
                                                               FontWeight="SemiBold" FontSize="12" Foreground="#172B4D" 
                                                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>

                                                <!-- Factor Controls: [-] Slider [+] Label -->
                                                <Grid Margin="0,4,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Button Grid.Column="0" Style="{StaticResource RoundMiniButton}" Content="-" 
                                                            Click="BtnDecreaseFactor_Click" Tag="{Binding}"/>

                                                    <Slider Grid.Column="1" Minimum="0.2" Maximum="3.0" SmallChange="0.1" LargeChange="0.2" 
                                                            Value="{Binding Factor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                            VerticalAlignment="Center" Margin="6,0"/>

                                                    <Button Grid.Column="2" Style="{StaticResource RoundMiniButton}" Content="+" 
                                                            Click="BtnIncreaseFactor_Click" Tag="{Binding}"/>

                                                    <TextBlock Grid.Column="3" Text="{Binding FactorDisplay}" FontWeight="Bold" 
                                                               FontSize="12" Foreground="#0052CC" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- BOTTOM ACTION BAR -->
        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#DFE1E6" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Status message / hint -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtStatusMessage" 
                               Text="💡 Gợi ý: Điều chỉnh hệ số cho các đoạn để hình vẽ cân đối, sau đó bấm 'Gán vào Shape Image này'." 
                               Foreground="#5E6C84" FontSize="12"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnAssignCurrent" Style="{StaticResource PrimaryButton}" 
                            Content="💾 Gán Vào Shape Image Này" Click="BtnAssignCurrent_Click"/>
                    <Button x:Name="BtnClose" Content="Đóng" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
