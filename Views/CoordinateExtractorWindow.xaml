<Window x:Class="ElementCoordinateExtractor.Views.CoordinateExtractorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Revit Element Coordinate Extractor" 
        Height="760" Width="1050"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        Background="#F4F5F7">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#C1C7D0"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#172B4D"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#EBECF0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#0052CC"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0052CC"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#0747A6"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00875A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#00875A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#006644"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,0,16,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- TOP SECTION: SELECT FAMILY & COORDINATE SYSTEM -->
        <Border Grid.Row="0" Background="#FFFFFF" Padding="14" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#DFE1E6" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Search and Select Family -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Tìm kiếm Family:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtSearchFamily" Grid.Column="1" Height="28" VerticalContentAlignment="Center" Padding="4,0" TextChanged="TxtSearchFamily_TextChanged"/>

                    <TextBlock Grid.Column="2" Text="Chọn Family:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboFamilies" Grid.Column="3" Height="28" VerticalContentAlignment="Center" SelectionChanged="CboFamilies_SelectionChanged"/>

                    <Button Grid.Column="4" Content="🔄 Tải lại" Margin="8,0,0,0" Click="BtnRefresh_Click"/>
                </Grid>

                <!-- Row 2: Coordinate System (RadioButtons) & Unit -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Hệ tọa độ:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <RadioButton x:Name="RbProjectBasePoint" Content="Project Base Point (Mốc dự án)" IsChecked="True" Checked="CoordinateSystem_Checked" ToolTip="Tọa độ tương đối theo mốc Project Base Point của Revit"/>
                        <RadioButton x:Name="RbSurveyPoint" Content="Survey Point (Mốc trắc địa / Shared)" Checked="CoordinateSystem_Checked" ToolTip="Tọa độ thực tế theo mốc trắc địa khu đất (East/West, North/South, Elevation)"/>
                        <RadioButton x:Name="RbInternalOrigin" Content="Internal Origin (Gốc Revit)" Checked="CoordinateSystem_Checked" ToolTip="Gốc tọa độ tuyệt đối bên trong file Revit"/>
                    </StackPanel>

                    <TextBlock Grid.Column="2" Text="Đơn vị:" VerticalAlignment="Center" Margin="16,0,8,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboUnits" Grid.Column="3" Height="28" VerticalContentAlignment="Center" SelectionChanged="CboUnits_SelectionChanged">
                        <ComboBoxItem Content="Millimeters (mm)" IsSelected="True"/>
                        <ComboBoxItem Content="Meters (m)"/>
                        <ComboBoxItem Content="Feet (ft)"/>
                    </ComboBox>
                </Grid>
            </Grid>
        </Border>

        <!-- PARAMETER MAPPING SECTION -->
        <Border Grid.Row="1" Background="#F0F4F8" Padding="12" CornerRadius="6" Margin="0,0,0,10" BorderBrush="#B3D4FF" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="🎯 Gán Tọa Độ Vào Parameters Của Element (Mapping X, Y, Z)" FontWeight="Bold" Foreground="#0747A6" Margin="0,0,0,8"/>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Param X -->
                    <TextBlock Grid.Column="0" Text="Param X:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboParamX" Grid.Column="1" Height="28" VerticalContentAlignment="Center"/>

                    <!-- Param Y -->
                    <TextBlock Grid.Column="2" Text="Param Y:" VerticalAlignment="Center" Margin="12,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboParamY" Grid.Column="3" Height="28" VerticalContentAlignment="Center"/>

                    <!-- Param Z -->
                    <TextBlock Grid.Column="4" Text="Param Z:" VerticalAlignment="Center" Margin="12,0,6,0" FontWeight="SemiBold"/>
                    <ComboBox x:Name="CboParamZ" Grid.Column="5" Height="28" VerticalContentAlignment="Center"/>

                    <!-- Execute Button -->
                    <Button Grid.Column="6" Content="💾 Ghi Vào Parameters" Style="{StaticResource AccentButton}" Margin="12,0,0,0" Click="BtnWriteParameters_Click" ToolTip="Cập nhật tọa độ tính toán vào 3 parameter đã chọn cho tất cả instance thuộc family này"/>
                </Grid>
            </Grid>
        </Border>

        <!-- CENTER DATAGRID -->
        <Border Grid.Row="2" Background="#FFFFFF" CornerRadius="6" BorderBrush="#DFE1E6" BorderThickness="1">
            <DataGrid x:Name="DgrResults" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True" 
                      CanUserSortColumns="True"
                      SelectionMode="Extended"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#EBECF0"
                      HeadersVisibility="Column"
                      RowBackground="#FFFFFF"
                      AlternatingRowBackground="#FAFBFC"
                      BorderThickness="0"
                      MouseDoubleClick="DgrResults_MouseDoubleClick"
                      SelectionChanged="DgrResults_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Element ID" Binding="{Binding ElementId}" Width="100"/>
                    <DataGridTextColumn Header="Type Name" Binding="{Binding TypeName}" Width="160"/>
                    <DataGridTextColumn Header="Mark" Binding="{Binding Mark}" Width="80"/>
                    <DataGridTextColumn Header="Level" Binding="{Binding LevelName}" Width="110"/>
                    <DataGridTextColumn x:Name="ColX" Header="X" Binding="{Binding FormattedX}" Width="120"/>
                    <DataGridTextColumn x:Name="ColY" Header="Y" Binding="{Binding FormattedY}" Width="120"/>
                    <DataGridTextColumn x:Name="ColZ" Header="Z" Binding="{Binding FormattedZ}" Width="120"/>
                    <DataGridTextColumn Header="Rotation" Binding="{Binding FormattedRotation}" Width="90"/>
                    <DataGridTextColumn Header="Loại hình học" Binding="{Binding GeometryType}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- BOTTOM ACTIONS SECTION -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TxtStatus" Grid.Column="0" Text="Sẵn sàng." VerticalAlignment="Center" Foreground="#5E6C84"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="🔍 Zoom &amp; Chọn trong Revit" Click="BtnShowSelected_Click"/>
                <Button Content="📋 Copy Bảng" Click="BtnCopyClipboard_Click"/>
                <Button Content="💾 Xuất file CSV / Excel" Style="{StaticResource PrimaryButton}" Click="BtnExportCsv_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
